info(
	title: "Global Dubai Travel API"
	desc: "Product, inventory, order and payment gateway APIs"
	version: "0.5.0"
)

// ── Types ─
type ProductListReq { Keyword string `form:"keyword,optional"`; Destination string `form:"destination,optional"`; Page int `form:"page,optional" validate:"gte=1"`; PageSize int `form:"pageSize,optional" validate:"gte=1,lte=100"` }
type Product { Id int64 `json:"id"`; TenantId int64 `json:"tenantId"`; MerchantId int64 `json:"merchantId"`; Code string `json:"code"`; Title string `json:"title"`; Slug string `json:"slug"`; Destination string `json:"destination"`; Description string `json:"description"`; Currency string `json:"currency"`; MinPrice int64 `json:"minPrice"`; Status string `json:"status"`; Highlights string `json:"highlights"`; CoverImage string `json:"coverImage"`; Images string `json:"images"`; VideoUrl string `json:"videoUrl"`; RichContent string `json:"richContent"`; BookingNotice string `json:"bookingNotice"` }
type ProductListResp { Items []Product `json:"items"`; Total int64 `json:"total"` }

type CreateProductReq { Code string `json:"code" validate:"required"`; Title string `json:"title" validate:"required"`; Slug string `json:"slug,optional"`; Destination string `json:"destination,optional"`; Description string `json:"description,optional"`; Currency string `json:"currency,optional"`; MinPrice int64 `json:"minPrice,optional" validate:"gte=0"`; Highlights string `json:"highlights,optional"`; CoverImage string `json:"coverImage,optional"`; Images string `json:"images,optional"`; VideoUrl string `json:"videoUrl,optional"`; RichContent string `json:"richContent,optional"`; BookingNotice string `json:"bookingNotice,optional"` }
type UpdateProductReq { Code string `json:"code" validate:"required"`; Title string `json:"title" validate:"required"`; Slug string `json:"slug,optional"`; Destination string `json:"destination,optional"`; Description string `json:"description,optional"`; Currency string `json:"currency,optional"`; MinPrice int64 `json:"minPrice,optional" validate:"gte=0"`; Highlights string `json:"highlights,optional"`; CoverImage string `json:"coverImage,optional"`; Images string `json:"images,optional"`; VideoUrl string `json:"videoUrl,optional"`; RichContent string `json:"richContent,optional"`; BookingNotice string `json:"bookingNotice,optional"` }
type PublishProductReq { Published bool `json:"published"` }

type ItineraryStopReq { StopType string `json:"stopType" validate:"required"`; Title string `json:"title" validate:"required"`; Description string `json:"description,optional"`; Sequence int `json:"sequence,optional"`; LocationName string `json:"locationName,optional"`; Address string `json:"address,optional"`; Latitude float64 `json:"latitude,optional"`; Longitude float64 `json:"longitude,optional"`; DurationMinutes int `json:"durationMinutes,optional"`; TransportType string `json:"transportType,optional"`; StartTime string `json:"startTime,optional"`; EndTime string `json:"endTime,optional"`; IsPickup bool `json:"isPickup,optional"`; IsDropoff bool `json:"isDropoff,optional"`; AgreementNoShopping bool `json:"agreementNoShopping,optional"`; AgreementAdjustable bool `json:"agreementAdjustable,optional"`; PoiId string `json:"poiId,optional"`; PoiName string `json:"poiName,optional"`; IsEntering bool `json:"isEntering,optional"`; DurationMode string `json:"durationMode,optional"`; DurationHours int `json:"durationHours,optional"`; ActivityFeatures string `json:"activityFeatures,optional"`; PickupLocation string `json:"pickupLocation,optional"`; PickupAddress string `json:"pickupAddress,optional"`; PickupLatitude float64 `json:"pickupLatitude,optional"`; PickupLongitude float64 `json:"pickupLongitude,optional"`; DropoffLocation string `json:"dropoffLocation,optional"`; DropoffAddress string `json:"dropoffAddress,optional"`; DropoffLatitude float64 `json:"dropoffLatitude,optional"`; DropoffLongitude float64 `json:"dropoffLongitude,optional"`; TypeParams string `json:"typeParams,optional"` }
type ItineraryStop { Id int64 `json:"id"`; ProductId int64 `json:"productId"`; StopType string `json:"stopType"`; Title string `json:"title"`; Description string `json:"description"`; Sequence int `json:"sequence"`; LocationName string `json:"locationName"`; Address string `json:"address"`; Latitude float64 `json:"latitude"`; Longitude float64 `json:"longitude"`; DurationMinutes int `json:"durationMinutes"`; TransportType string `json:"transportType"`; StartTime string `json:"startTime"`; EndTime string `json:"endTime"`; IsPickup bool `json:"isPickup"`; IsDropoff bool `json:"isDropoff"`; AgreementNoShopping bool `json:"agreementNoShopping"`; AgreementAdjustable bool `json:"agreementAdjustable"`; PoiId string `json:"poiId"`; PoiName string `json:"poiName"`; IsEntering bool `json:"isEntering"`; DurationMode string `json:"durationMode"`; DurationHours int `json:"durationHours"`; ActivityFeatures string `json:"activityFeatures"`; PickupLocation string `json:"pickupLocation"`; PickupAddress string `json:"pickupAddress"`; PickupLatitude float64 `json:"pickupLatitude"`; PickupLongitude float64 `json:"pickupLongitude"`; DropoffLocation string `json:"dropoffLocation"`; DropoffAddress string `json:"dropoffAddress"`; DropoffLatitude float64 `json:"dropoffLatitude"`; DropoffLongitude float64 `json:"dropoffLongitude"`; TypeParams string `json:"typeParams"` }
type ItineraryStopListResp { Items []ItineraryStop `json:"items"` }

type PackageReq { Code string `json:"code" validate:"required"`; Name string `json:"name" validate:"required"`; PricingMode string `json:"pricingMode,optional"`; InventoryMode string `json:"inventoryMode,optional"`; MinOrderQty int `json:"minOrderQty,optional"`; SellCurrency string `json:"sellCurrency,optional"`; CostCurrency string `json:"costCurrency,optional"`; GroupPrices string `json:"groupPrices,optional"`; TierPrices string `json:"tierPrices,optional"` }
type Package { Id int64 `json:"id"`; ProductId int64 `json:"productId"`; Code string `json:"code"`; Name string `json:"name"`; Status string `json:"status"`; PricingMode string `json:"pricingMode"`; InventoryMode string `json:"inventoryMode"`; MinOrderQty int `json:"minOrderQty"`; SellCurrency string `json:"sellCurrency"`; CostCurrency string `json:"costCurrency"`; GroupPrices string `json:"groupPrices"`; TierPrices string `json:"tierPrices"` }
type PackageListResp { Items []Package `json:"items"` }

type InventoryUpsertReq { Date string `json:"date" validate:"required"`; TimeSlot string `json:"timeSlot,optional"`; Capacity int `json:"capacity" validate:"gte=0"`; UnitPrice int64 `json:"unitPrice" validate:"gte=0"`; Currency string `json:"currency,optional"`; Status string `json:"status,optional"`; InventoryMode string `json:"inventoryMode,optional"`; TotalCapacity int `json:"totalCapacity,optional"`; IsOpen bool `json:"isOpen,optional"` }
type InventoryItem { Id int64 `json:"id"`; PackageId int64 `json:"packageId"`; Date string `json:"date"`; TimeSlot string `json:"timeSlot"`; Capacity int32 `json:"capacity"`; Reserved int32 `json:"reserved"`; UnitPrice int64 `json:"unitPrice"`; Currency string `json:"currency"`; Status string `json:"status"`; InventoryMode string `json:"inventoryMode"`; TotalCapacity int32 `json:"totalCapacity"`; IsOpen bool `json:"isOpen"` }
type InventoryListResp { Items []InventoryItem `json:"items"` }

type InventoryCheckReq { PackageId int64 `json:"packageId" validate:"gt=0"`; Date string `json:"date" validate:"required"`; TimeSlot string `json:"timeSlot,optional"`; Quantity int `json:"quantity" validate:"gt=0"` }
type InventoryCheckResp { Available bool `json:"available"`; Remaining int32 `json:"remaining"`; UnitPrice int64 `json:"unitPrice"`; Currency string `json:"currency"` }

// GET query params — json optional prevents ParseJsonBody from failing on empty body
type InventoryBatchReq { StartDate string `form:"startDate" json:"startDate,optional" validate:"required"`; EndDate string `form:"endDate" json:"endDate,optional" validate:"required"` }

type Traveler { Id int64 `json:"id,optional"`; Name string `json:"name"`; IdType string `json:"idType"`; IdNumber string `json:"idNumber"`; Phone string `json:"phone"` }
type CreateOrderReq { ProductId int64 `json:"productId" validate:"gt=0"`; PackageId int64 `json:"packageId" validate:"gt=0"`; Date string `json:"date" validate:"required"`; TimeSlot string `json:"timeSlot,optional"`; Quantity int `json:"quantity" validate:"gt=0"`; CustomerEmail string `json:"customerEmail,optional"`; CustomerName string `json:"customerName,optional"`; CustomerPhone string `json:"customerPhone,optional"`; Travelers []Traveler `json:"travelers,optional"`; Remark string `json:"remark,optional"`; DisplayCurrency string `json:"displayCurrency,optional"`; ReservationKey string `json:"reservationKey" validate:"required"` }
type OrderItem { Id int64 `json:"id"`; ProductId int64 `json:"productId"`; PackageId int64 `json:"packageId"`; TravelerId int64 `json:"travelerId"`; Quantity int32 `json:"quantity"`; UnitPrice int64 `json:"unitPrice"`; TotalAmount int64 `json:"totalAmount"`; ServiceDate string `json:"serviceDate"`; TimeSlot string `json:"timeSlot"`; ProductCode string `json:"productCode"`; ProductName string `json:"productName"`; PackageCode string `json:"packageCode"`; PackageName string `json:"packageName"` }
type CreateOrderResp { Id int64 `json:"id"`; OrderNo string `json:"orderNo"`; Status string `json:"status"`; TotalAmount int64 `json:"totalAmount"`; Currency string `json:"currency"`; CustomerEmail string `json:"customerEmail"`; PaymentStatus string `json:"paymentStatus"`; CustomerId int64 `json:"customerId"`; CustomerName string `json:"customerName"`; CustomerPhone string `json:"customerPhone"`; Remark string `json:"remark"`; Travelers []Traveler `json:"travelers,optional"`; Items []OrderItem `json:"items,optional"`; ProductName string `json:"productName"`; PackageName string `json:"packageName"`; ServiceDate string `json:"serviceDate"`; TimeSlot string `json:"timeSlot"`; RejectReason string `json:"rejectReason,optional"`; VerifiedAt int64 `json:"verifiedAt,optional"`; DisplayCurrency string `json:"displayCurrency,optional"`; ExchangeRate float64 `json:"exchangeRate,optional"`; DisplayAmount float64 `json:"displayAmount,optional"` }
type OrderListResp { Items []CreateOrderResp `json:"items"`; Total int64 `json:"total"` }

type OrderListReq { Status string `form:"status,optional"`; Page int `form:"page,optional" validate:"gte=1"`; PageSize int `form:"pageSize,optional" validate:"gte=1,lte=100"` }

type CreatePaymentReq { OrderNo string `json:"orderNo" validate:"required"`; Provider string `json:"provider" validate:"required"`; IdempotencyKey string `json:"idempotencyKey" validate:"required"` }
type PaymentResp { Id int64 `json:"id"`; PaymentNo string `json:"paymentNo"`; OrderNo string `json:"orderNo"`; Provider string `json:"provider"`; ProviderPaymentId string `json:"providerPaymentId"`; Amount int64 `json:"amount"`; Currency string `json:"currency"`; Status string `json:"status"`; CheckoutURL string `json:"checkoutUrl,optional"` }
type StripeIntentResp { PaymentNo string `json:"paymentNo"`; ClientSecret string `json:"clientSecret"`; PublishableKey string `json:"publishableKey"` }

type RegisterReq { Username string `json:"username" validate:"required,min=3,max=32"`; Password string `json:"password" validate:"required,min=6,max=64"`; Email string `json:"email" validate:"required,email"`; Mobile string `json:"mobile,optional"`; Nickname string `json:"nickname,optional"`; CaptchaId string `json:"captchaId" validate:"required"`; CaptchaAnswer string `json:"captchaAnswer" validate:"required"`; EmailCode string `json:"emailCode" validate:"required"` }
type LoginReq { Email string `json:"email" validate:"required,email"`; CaptchaId string `json:"captchaId" validate:"required"`; CaptchaAnswer string `json:"captchaAnswer" validate:"required"`; EmailCode string `json:"emailCode" validate:"required"` }
type LoginByMobileReq { Mobile string `json:"mobile" validate:"required"`; Password string `json:"password" validate:"required"` }
type AuthTokenResp { Token string `json:"token"`; User UserProfile `json:"user"` }
type UserProfile { Id int64 `json:"id"`; Username string `json:"username"`; Nickname string `json:"nickname"`; Email string `json:"email"`; Mobile string `json:"mobile"`; Avatar string `json:"avatar"`; Level int32 `json:"level"`; Gender int32 `json:"gender"`; Birthday string `json:"birthday"`; Bio string `json:"bio"`; Money float64 `json:"money"`; Score int32 `json:"score"`; Jointime int64 `json:"jointime"`; Logintime int64 `json:"logintime"`; Loginip string `json:"loginip"`; Status string `json:"status"`; Createtime int64 `json:"createtime"` }
type UpdateProfileReq { Nickname string `json:"nickname,optional"`; Avatar string `json:"avatar,optional"`; Email string `json:"email,optional"`; Mobile string `json:"mobile,optional"`; Bio string `json:"bio,optional"`; Birthday string `json:"birthday,optional"`; Gender int32 `json:"gender,optional"` }
type ChangePasswordReq { OldPassword string `json:"oldPassword" validate:"required"`; NewPassword string `json:"newPassword" validate:"required,min=6,max=64"` }
type OkResp { Ok bool `json:"ok"`; Msg string `json:"msg"` }

type CaptchaResp { CaptchaId string `json:"captchaId"`; CaptchaImage string `json:"captchaImage"` }
type SendEmailCodeReq { Email string `json:"email" validate:"required,email"`; CaptchaId string `json:"captchaId" validate:"required"`; CaptchaAnswer string `json:"captchaAnswer" validate:"required"` }

type VerifyOrderReq { Action string `json:"action" validate:"required,oneof=CONFIRM REJECT"`; Reason string `json:"reason,optional"` }
type VerifyOrderResp { OrderNo string `json:"orderNo"`; Status string `json:"status"`; RejectReason string `json:"rejectReason,optional"`; VerifiedAt int64 `json:"verifiedAt,optional"` }

type AcceptOrderReq { Action string `json:"action" validate:"required,oneof=ACCEPT REJECT"`; Reason string `json:"reason,optional"` }
type AcceptOrderResp { OrderNo string `json:"orderNo"`; Status string `json:"status"`; RejectReason string `json:"rejectReason,optional"` }

type RequestRefundReq { Reason string `json:"reason" validate:"required"` }
type RequestRefundResp { OrderNo string `json:"orderNo"`; Status string `json:"status"`; RejectReason string `json:"rejectReason,optional"` }

type HandleRefundReq { Action string `json:"action" validate:"required,oneof=APPROVE REJECT"`; Reason string `json:"reason,optional"` }
type HandleRefundResp { OrderNo string `json:"orderNo"`; Status string `json:"status"`; RejectReason string `json:"rejectReason,optional"` }

type CancelOrderResp { OrderNo string `json:"orderNo"`; Status string `json:"status"` }

type CreateReviewReq { OrderNo string `json:"orderNo" validate:"required"`; ProductId int64 `json:"productId" validate:"gt=0"`; Rating int `json:"rating" validate:"gte=1,lte=5"`; ServiceRating int `json:"serviceRating,optional"`; ValueRating int `json:"valueRating,optional"`; Content string `json:"content,optional"`; Images string `json:"images,optional"` }
type Review { Id int64 `json:"id"`; OrderNo string `json:"orderNo"`; ProductId int64 `json:"productId"`; UserId int64 `json:"userId"`; Rating int32 `json:"rating"`; ServiceRating int32 `json:"serviceRating"`; ValueRating int32 `json:"valueRating"`; Content string `json:"content"`; Images string `json:"images"`; ReplyContent string `json:"replyContent,optional"`; ReplyTime int64 `json:"replyTime,optional"`; Status string `json:"status"`; UserName string `json:"userName,optional"`; ProductName string `json:"productName,optional"` }
type ReviewListResp { Items []Review `json:"items"`; Total int64 `json:"total"`; AvgRating float64 `json:"avgRating"` }
type ReplyReviewReq { ReplyContent string `json:"replyContent" validate:"required"` }

// ── Currency & Exchange Rate Types ──
type Currency { Code string `json:"code"`; Symbol string `json:"symbol"`; NameKey string `json:"nameKey,optional"`; Decimals int32 `json:"decimals"`; SymbolPosition string `json:"symbolPosition"`; IsBase bool `json:"isBase"` }
type CurrencyListResp { Items []Currency `json:"items"` }
type ExchangeRate { BaseCurrency string `json:"baseCurrency"`; TargetCurrency string `json:"targetCurrency"`; Rate float64 `json:"rate"`; RateMicro int64 `json:"rateMicro"`; EffectiveAt int64 `json:"effectiveAt,optional"` }
type ExchangeRateListReq { Base string `form:"base,optional" json:"base,optional"` }
type ExchangeRateListResp { Items []ExchangeRate `json:"items"` }

// ── Attraction Types ──
type Attraction { Id int64 `json:"id"`; TenantId int64 `json:"tenantId"`; MerchantId int64 `json:"merchantId"`; Name string `json:"name"`; NameEn string `json:"nameEn,optional"`; Category string `json:"category,optional"`; Tags string `json:"tags,optional"`; City string `json:"city,optional"`; CityId int64 `json:"cityId,optional"`; Address string `json:"address,optional"`; Latitude float64 `json:"latitude,optional"`; Longitude float64 `json:"longitude,optional"`; PoiId string `json:"poiId,optional"`; PoiName string `json:"poiName,optional"`; CoverImage string `json:"coverImage,optional"`; Images string `json:"images,optional"`; Description string `json:"description,optional"`; RichContent string `json:"richContent,optional"`; OpeningHours string `json:"openingHours,optional"`; SuggestedDuration string `json:"suggestedDuration,optional"`; TicketInfo string `json:"ticketInfo,optional"`; Sort int `json:"sort,optional"`; Status string `json:"status,optional"`; Translations []AttractionTranslationItem `json:"translations,optional"` }
type AttractionTranslationItem { Locale string `json:"locale"`; Name string `json:"name,optional"`; Category string `json:"category,optional"`; Tags string `json:"tags,optional"`; Address string `json:"address,optional"`; Description string `json:"description,optional"`; OpeningHours string `json:"openingHours,optional"`; SuggestedDuration string `json:"suggestedDuration,optional"`; TicketInfo string `json:"ticketInfo,optional"` }
type AttractionListReq { Keyword string `form:"keyword,optional"`; Category string `form:"category,optional"`; Status string `form:"status,optional"`; Locale string `form:"locale,optional"`; Page int `form:"page,optional" validate:"gte=1"`; PageSize int `form:"pageSize,optional" validate:"gte=1,lte=100"` }
type AttractionListResp { Items []Attraction `json:"items"`; Total int64 `json:"total"` }
type AttractionReq { Name string `json:"name" validate:"required"`; NameEn string `json:"nameEn,optional"`; Category string `json:"category,optional"`; Tags string `json:"tags,optional"`; City string `json:"city,optional"`; CityId int64 `json:"cityId,optional"`; Address string `json:"address,optional"`; Latitude float64 `json:"latitude,optional"`; Longitude float64 `json:"longitude,optional"`; PoiId string `json:"poiId,optional"`; PoiName string `json:"poiName,optional"`; CoverImage string `json:"coverImage,optional"`; Images string `json:"images,optional"`; Description string `json:"description,optional"`; RichContent string `json:"richContent,optional"`; OpeningHours string `json:"openingHours,optional"`; SuggestedDuration string `json:"suggestedDuration,optional"`; TicketInfo string `json:"ticketInfo,optional"`; Sort int `json:"sort,optional"`; Status string `json:"status,optional"`; Translations []AttractionTranslationItem `json:"translations,optional"` }

// ── Region (Country -> City) Types ──
type RegionTranslationItem { Locale string `json:"locale"`; Name string `json:"name"` }
type Region { Id int64 `json:"id"`; ParentId int64 `json:"parentId"`; Level string `json:"level"`; Code string `json:"code,optional"`; Name string `json:"name"`; PoiId string `json:"poiId,optional"`; PoiName string `json:"poiName,optional"`; Latitude float64 `json:"latitude,optional"`; Longitude float64 `json:"longitude,optional"`; Sort int `json:"sort,optional"`; Status string `json:"status,optional"`; Translations []RegionTranslationItem `json:"translations,optional"` }
type RegionListReq { Level string `form:"level,optional"`; ParentId int64 `form:"parentId,optional"`; Keyword string `form:"keyword,optional"`; Locale string `form:"locale,optional"`; Status string `form:"status,optional"` }
type RegionListResp { Items []Region `json:"items"`; Total int64 `json:"total"` }
type RegionReq { ParentId int64 `json:"parentId,optional"`; Level string `json:"level" validate:"required,oneof=COUNTRY CITY"`; Code string `json:"code,optional"`; Name string `json:"name" validate:"required"`; PoiId string `json:"poiId,optional"`; PoiName string `json:"poiName,optional"`; Latitude float64 `json:"latitude,optional"`; Longitude float64 `json:"longitude,optional"`; Sort int `json:"sort,optional"`; Status string `json:"status,optional"`; Translations []RegionTranslationItem `json:"translations,optional"` }

// ── Config Management Types ──
type ConfigItem { ConfigType string `json:"configType"`; ConfigKey string `json:"configKey"`; ConfigValue string `json:"configValue"`; Description string `json:"description,optional"` }
type ConfigGroup { ConfigType string `json:"configType"`; Items []ConfigItem `json:"items"` }
type ConfigSaveReq { ConfigType string `json:"configType" validate:"required"`; Items []ConfigItem `json:"items" validate:"required"` }
type ConfigGetResp { ConfigType string `json:"configType"`; Items []ConfigItem `json:"items"` }

// ─ Service Routes ──
service travel-api {
	@handler ListProducts
	get /api/travel/products (ProductListReq) returns (ProductListResp)

	@handler ProductDetail
	get /api/travel/products/:id returns (Product)

	@handler ListPackages
	get /api/travel/products/:id/packages returns (PackageListResp)

	@handler ListProductItineraryStops
	get /api/travel/products/:id/itinerary-stops returns (ItineraryStopListResp)

	@handler ListMerchantProducts
	get /api/travel/merchant/products (ProductListReq) returns (ProductListResp)

	@handler CreateProduct
	post /api/travel/merchant/products (CreateProductReq) returns (Product)

	@handler UpdateProduct
	put /api/travel/merchant/products/:id (UpdateProductReq) returns (Product)

	@handler PublishProduct
	post /api/travel/merchant/products/:id/publish (PublishProductReq) returns (Product)

	@handler CreatePackage
	post /api/travel/merchant/products/:id/packages (PackageReq) returns (Package)

	@handler ListMerchantPackages
	get /api/travel/merchant/products/:id/packages returns (PackageListResp)

	@handler UpdatePackage
	put /api/travel/merchant/packages/:id (PackageReq) returns (Package)

	@handler UpsertInventory
	post /api/travel/merchant/packages/:id/inventory (InventoryUpsertReq) returns (InventoryItem)

	@handler ListInventory
	get /api/travel/merchant/packages/:id/inventory returns (InventoryListResp)

	@handler CreateItineraryStop
	post /api/travel/merchant/products/:id/itinerary-stops (ItineraryStopReq) returns (ItineraryStop)

	@handler UpdateItineraryStop
	put /api/travel/merchant/products/:id/itinerary-stops/:stopId (ItineraryStopReq) returns (ItineraryStop)

	@handler DeleteItineraryStop
	delete /api/travel/merchant/products/:id/itinerary-stops/:stopId returns (OkResp)

	@handler ListItineraryStops
	get /api/travel/merchant/products/:id/itinerary-stops returns (ItineraryStopListResp)

	@handler CheckInventory
	post /api/travel/inventory/check (InventoryCheckReq) returns (InventoryCheckResp)

	@handler BatchInventory
	get /api/travel/inventory/packages/:packageId/batch (InventoryBatchReq) returns (InventoryListResp)

	@handler CreateOrder
	post /api/travel/orders (CreateOrderReq) returns (CreateOrderResp)

	@handler GetOrder
	get /api/travel/orders/:orderNo returns (CreateOrderResp)

	@handler ListMerchantOrders
	get /api/travel/merchant/orders (OrderListReq) returns (OrderListResp)

	@handler ListMyOrders
	get /api/travel/my/orders (OrderListReq) returns (OrderListResp)

	@handler CreatePayment
	post /api/travel/payments (CreatePaymentReq) returns (PaymentResp)

	@handler GetPayment
	get /api/travel/payments/:paymentNo returns (PaymentResp)

	@handler PayPalReturn
	get /api/travel/payments/paypal/return returns (PaymentResp)

	@handler PayPalCancel
	get /api/travel/payments/paypal/cancel returns (OkResp)

	@handler PayPalWebhook
	post /api/travel/payments/paypal/webhook

	// ── Stripe Payment ──
	@handler StripeCreateIntent
	post /api/travel/payments/stripe/intent (CreatePaymentReq) returns (StripeIntentResp)

	@handler StripeWebhook
	post /api/travel/payments/stripe/webhook

	// ── Shopify Sales Channel ──
	@handler SyncProductToShopify
	post /api/travel/merchant/products/:id/sync-shopify returns (OkResp)

	@handler ShopifyWebhook
	post /api/travel/shopify/webhook

	@handler Register
	post /api/travel/user/register (RegisterReq) returns (AuthTokenResp)

	@handler Login
	post /api/travel/user/login (LoginReq) returns (AuthTokenResp)

	@handler LoginByMobile
	post /api/travel/user/login-mobile (LoginByMobileReq) returns (AuthTokenResp)

	@handler Captcha
	get /api/travel/captcha returns (CaptchaResp)

	@handler SendEmailCode
	post /api/travel/user/send-email-code (SendEmailCodeReq) returns (OkResp)

	@handler GetProfile
	get /api/travel/user/profile returns (UserProfile)

	@handler UpdateProfile
	put /api/travel/user/profile (UpdateProfileReq) returns (UserProfile)

	@handler ChangePassword
	put /api/travel/user/password (ChangePasswordReq) returns (OkResp)

	@handler VerifyOrder
	post /api/travel/merchant/orders/:orderNo/verify (VerifyOrderReq) returns (VerifyOrderResp)

	@handler AcceptOrder
	post /api/travel/merchant/orders/:orderNo/accept (AcceptOrderReq) returns (AcceptOrderResp)

	@handler HandleRefund
	post /api/travel/merchant/orders/:orderNo/refund/handle (HandleRefundReq) returns (HandleRefundResp)

	@handler RequestRefund
	post /api/travel/my/orders/:orderNo/refund (RequestRefundReq) returns (RequestRefundResp)

	@handler CancelOrder
	post /api/travel/my/orders/:orderNo/cancel returns (CancelOrderResp)

	@handler CreateReview
	post /api/travel/reviews (CreateReviewReq) returns (Review)

	@handler ListProductReviews
	get /api/travel/products/:id/reviews (ProductListReq) returns (ReviewListResp)

	@handler GetOrderReview
	get /api/travel/my/orders/:orderNo/review returns (Review)

	@handler ReplyReview
	post /api/travel/merchant/reviews/:id/reply (ReplyReviewReq) returns (Review)

	// ── Currency & Exchange Rate (public reference data) ──
	@handler ListCurrencies
	get /api/travel/currencies returns (CurrencyListResp)

	@handler ListExchangeRates
	get /api/travel/currencies/rates (ExchangeRateListReq) returns (ExchangeRateListResp)

	// ── Config Management ──
	@handler GetMerchantConfig
	get /api/travel/merchant/config/:configType returns (ConfigGetResp)

	@handler SaveMerchantConfig
	post /api/travel/merchant/config (ConfigSaveReq) returns (OkResp)

	// ── Attractions (merchant management) ──
	@handler ListMerchantAttractions
	get /api/travel/merchant/attractions (AttractionListReq) returns (AttractionListResp)

	@handler GetMerchantAttraction
	get /api/travel/merchant/attractions/:id returns (Attraction)

	@handler CreateAttraction
	post /api/travel/merchant/attractions (AttractionReq) returns (Attraction)

	@handler UpdateAttraction
	put /api/travel/merchant/attractions/:id (AttractionReq) returns (Attraction)

	@handler DeleteAttraction
	delete /api/travel/merchant/attractions/:id returns (OkResp)

	// ── Attractions (public/client) ──
	@handler ListAttractions
	get /api/travel/attractions (AttractionListReq) returns (AttractionListResp)

	@handler GetAttraction
	get /api/travel/attractions/:id returns (Attraction)

	@handler ListAttractionProducts
	get /api/travel/attractions/:id/products returns (ProductListResp)

	@handler ListProductAttractions
	get /api/travel/products/:id/attractions returns (AttractionListResp)

	// ── Regions: country/city dictionary (public reference) ──
	@handler ListRegions
	get /api/travel/regions (RegionListReq) returns (RegionListResp)

	// ── Regions (merchant management) ──
	@handler ListMerchantRegions
	get /api/travel/merchant/regions (RegionListReq) returns (RegionListResp)

	@handler CreateRegion
	post /api/travel/merchant/regions (RegionReq) returns (Region)

	@handler UpdateRegion
	put /api/travel/merchant/regions/:id (RegionReq) returns (Region)

	@handler DeleteRegion
	delete /api/travel/merchant/regions/:id returns (OkResp)
}